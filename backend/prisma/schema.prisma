generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @unique @map("employee_id") @db.VarChar(50)
  fullName      String    @map("full_name") @db.VarChar(100)
  designation   String?   @db.VarChar(100)
  phone         String?   @db.VarChar(20)
  email         String?   @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  role          UserRole  @default(employee)
  avatarUrl     String?   @map("avatar_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  sectionId     String?   @map("section_id") @db.Uuid
  assignedTasks Task[]    @relation("AssignedTo")
  section       Section?  @relation(fields: [sectionId], references: [id])

  @@map("users")
}

model Section {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]

  @@map("sections")
}

model KpiPeriod {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tasks     Task[]

  @@map("kpi_periods")
}

model Task {
  id           String      @id @default(uuid()) @db.Uuid
  title        String      @db.VarChar(255)
  description  String?
  fileNumber   String      @map("file_number") @db.VarChar(50)
  kpiScore     Decimal     @default(0) @map("kpi_score") @db.Decimal(5, 2)
  deadline     DateTime    @db.Date
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  kpiPeriodId  String      @map("kpi_period_id") @db.Uuid
  assignedToId String?     @map("assigned_to") @db.Uuid
  submission   Submission?
  assignedTo   User?       @relation("AssignedTo", fields: [assignedToId], references: [id])
  kpiPeriod    KpiPeriod   @relation(fields: [kpiPeriodId], references: [id])

  @@map("tasks")
}

model Submission {
  id                  String   @id @default(uuid()) @db.Uuid
  completedFileNumber String   @map("completed_file_number") @db.VarChar(50)
  submittedAt         DateTime @default(now()) @map("submitted_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  taskId              String   @unique @map("task_id") @db.Uuid
  task                Task     @relation(fields: [taskId], references: [id])

  @@map("submissions")
}

enum UserRole {
  admin
  employee
}
